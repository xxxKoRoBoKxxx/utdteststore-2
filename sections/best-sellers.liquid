{%- if section.blocks.size > 0 -%}
  {{ 'section-best-sellers.css' | asset_url | stylesheet_tag }}

  <div class="best-sellers best-sellers-{{ section.id }}">
    <div class="best-sellers__container page-width">
      <div class="best-sellers__collections-wrapper">
        <div class="best-sellers__collections">
          {%- if section.settings.label != blank or section.settings.title != blank -%}
            <div class="best-sellers__header">
              {%- if section.settings.label != blank -%}
                <span class="best-sellers__label">{{ section.settings.label }}</span>
              {%- endif -%}

              {%- if section.settings.title != blank -%}
                <h2 class="best-sellers__title">{{ section.settings.title }}</h2>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- liquid
              assign collection_title = ''

              if block.settings.text != blank
                assign collection_title = block.settings.text
              elsif block.settings.collection != blank
                assign collection_title = block.settings.collection.title
              endif
            -%}

            {%- if collection_title != blank -%}
              <div
                class="best-sellers__collection-item{% if forloop.first %} active{% endif %}"
                data-block-id="{{ block.id }}"
                data-collection-item
                {{ block.shopify_attributes }}
              >
                {{ collection_title }}
                {{ 'icon-arrow.svg' | inline_asset_content }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <div class="best-sellers__product-display">
        {%- for block in section.blocks -%}
          {%- liquid
            assign display_product = null

            if block.settings.product != blank
              assign display_product = block.settings.product
            elsif block.settings.collection != blank and block.settings.collection.products.first != blank
              assign display_product = block.settings.collection.products.first
            endif
          -%}

          {%- if display_product != blank -%}
            <div
              class="best-sellers__product-card{% unless forloop.first %} hidden{% endunless %}"
              data-block-id="{{ block.id }}"
              data-product-card
              data-product-id="{{ display_product.id }}"
              data-product-title="{{ display_product.title | escape }}"
              data-variant-id="{{ display_product.selected_or_first_available_variant.id }}"
              data-available="{{ display_product.selected_or_first_available_variant.available }}"
              data-wishlist-message="{{ 'sections.best_sellers.wishlist_message' | t: product_name: display_product.title }}"
            >
              <div class="best-sellers__product-image-wrapper">
                <a href="{{ display_product.url }}">
                  {%- if display_product.featured_image -%}
                    <picture class="best-sellers__product-image">
                      <source
                        media="(max-width: 767px)"
                        srcset="{{ display_product.featured_media | image_url: width: 600 }} 1x, {{ display_product.featured_media | image_url: width: 1200 }} 2x"
                      >
                      <source
                        media="(min-width: 768px)"
                        srcset="{{ display_product.featured_media | image_url: width: 800 }} 1x, {{ display_product.featured_media | image_url: width: 1600 }} 2x"
                      >
                      <img
                        src="{{ display_product.featured_media | image_url: width: 800 }}"
                        alt="{{ display_product.featured_media.alt | default: display_product.title | escape }}"
                        loading="lazy"
                        width="{{ display_product.featured_media.width }}"
                        height="{{ display_product.featured_media.height }}"
                      >
                    </picture>
                  {%- else -%}
                    <div class="best-sellers__product-placeholder">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {%- endif -%}
                </a>

                {%- if display_product.tags.size > 0 -%}
                  <div class="best-sellers__product-tags">
                    {%- for tag in display_product.tags limit: 3 -%}
                      <span class="best-sellers__product-tag{% if tag == 'Sale' %} best-sellers__product-tag--sale{% endif %}">
                        {{ tag }}
                      </span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                <div class="best-sellers__product-actions">
                  <button
                    type="button"
                    class="best-sellers__action-btn best-sellers__wishlist-btn"
                    data-wishlist-btn
                    aria-label="{{ 'sections.best_sellers.wishlist_button_label' | t }}"
                  >
                    {{ 'icon-heart-2.svg' | inline_asset_content }}
                  </button>

                  <button
                    type="button"
                    class="best-sellers__action-btn best-sellers__cart-btn"
                    data-cart-btn
                    aria-label="{{ 'sections.best_sellers.cart_button_label' | t }}"
                    {% unless display_product.selected_or_first_available_variant.available %}
                      disabled
                    {% endunless %}
                  >
                    {{ 'icon-eye-2.svg' | inline_asset_content }}
                  </button>
                </div>

                <div class="best-sellers__product-info">
                  <p class="best-sellers__product-title">
                    <a href="{{ display_product.url }}">{{ display_product.title }}</a>
                  </p>

                  <div class="best-sellers__product-price">
                    {{ display_product.price | money }}
                    {%- if display_product.compare_at_price > display_product.price -%}
                      <span class="best-sellers__product-compare-price">
                        {{- display_product.compare_at_price | money -}}
                      </span>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="best-sellers__modal-overlay hidden" data-modal-overlay>
      <div class="best-sellers__modal">
        <button type="button" class="best-sellers__modal-close" data-modal-close aria-label="Close">&times;</button>
        <div class="best-sellers__modal-content" data-modal-content></div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const section = document.querySelector('.best-sellers-{{ section.id }}');
      if (!section) return;

      const collectionItems = section.querySelectorAll('[data-collection-item]');
      const productCards = section.querySelectorAll('[data-product-card]');
      const modalOverlay = section.querySelector('[data-modal-overlay]');
      const modalContent = section.querySelector('[data-modal-content]');
      const modalClose = section.querySelector('[data-modal-close]');

      section.addEventListener('click', function (e) {
        const collectionItem = e.target.closest('[data-collection-item]');
        if (collectionItem) {
          const blockId = collectionItem.dataset.blockId;

          collectionItems.forEach((col) => col.classList.remove('active'));
          collectionItem.classList.add('active');

          productCards.forEach((card) => {
            if (card.dataset.blockId === blockId) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          });
          return;
        }

        const wishlistBtn = e.target.closest('[data-wishlist-btn]');
        if (wishlistBtn) {
          const productCard = wishlistBtn.closest('[data-product-card]');
          const wishlistMessage = productCard.dataset.wishlistMessage;

          modalContent.textContent = wishlistMessage;
          modalOverlay.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          return;
        }

        const cartBtn = e.target.closest('[data-cart-btn]');
        if (cartBtn && !cartBtn.disabled) {
          const productCard = cartBtn.closest('[data-product-card]');
          const variantId = productCard.dataset.variantId;

          cartBtn.disabled = true;
          cartBtn.style.opacity = '0.5';

          fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: variantId,
              quantity: 1,
            }),
          })
            .then((response) => response.json())
            .then((data) => {
              console.log('Product added to cart:', data);
            })
            .catch((error) => {
              console.error('Error adding to cart:', error);
              alert('Error adding product to cart. Please try again.');
            })
            .finally(() => {
              cartBtn.disabled = false;
              cartBtn.style.opacity = '';
            });
          return;
        }
      });

      function closeModal() {
        modalOverlay.classList.add('hidden');
        document.body.style.overflow = '';
      }

      if (modalClose) {
        modalClose.addEventListener('click', closeModal);
      }

      modalOverlay.addEventListener('click', function (e) {
        if (e.target === modalOverlay) {
          closeModal();
        }
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !modalOverlay.classList.contains('hidden')) {
          closeModal();
        }
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.best-sellers.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:sections.best-sellers.settings.label.label",
      "default": "t:sections.best-sellers.settings.label.default"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.best-sellers.settings.title.label",
      "default": "t:sections.best-sellers.settings.title.default"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.best-sellers.blocks.collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.best-sellers.blocks.collection.settings.collection.label"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.best-sellers.blocks.collection.settings.text.label",
          "info": "t:sections.best-sellers.blocks.collection.settings.text.info"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.best-sellers.blocks.collection.settings.product.label",
          "info": "t:sections.best-sellers.blocks.collection.settings.product.info"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "t:sections.best-sellers.presets.name"
    }
  ]
}
{% endschema %}
